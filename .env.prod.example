# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, redis, mailpit (dev only).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=woocommerce

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the store.
WP_URL=https://shop.example.com
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Credentials (REQUIRED, use long random values: openssl rand -base64 24)
# ---------------------------------------------------------------------------
DB_PASSWORD=
DB_ROOT_PASSWORD=
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=
#WP_ADMIN_USER=admin
#DB_NAME=wordpress
#DB_USER=wordpress

# ---------------------------------------------------------------------------
# Store (initial settings, applied only on the first install)
# ---------------------------------------------------------------------------
#WP_TITLE=WooCommerce
#WP_LOCALE=es_CL
#WC_COUNTRY=CL
#WC_CURRENCY=CLP

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Empty = install the latest WooCommerce once, then update it from the admin.
# Set = pin that exact version (enforced on every `up`).
#WC_VERSION=
# WordPress image version: only used when the wp_data volume is created.
# Afterwards WordPress core is updated from the admin.
#WP_VERSION=7.1.2
#PHP_VERSION=8.4
#WPCLI_VERSION=2.12
#CADDY_VERSION=2.11
#MARIADB_VERSION=12.3
#REDIS_VERSION=8.8
#MAILPIT_VERSION=v1.31

# ---------------------------------------------------------------------------
# WordPress / PHP
# ---------------------------------------------------------------------------
#WP_ENVIRONMENT_TYPE=production
#WP_DEBUG=0
#WP_DISALLOW_FILE_EDIT=true
#PHP_MEMORY_LIMIT=256M
#PHP_MAX_EXECUTION_TIME=300
# Max upload/request size (PHP and Caddy).
#UPLOAD_MAX_SIZE=64M
# PHP-FPM pool. Rough sizing: max_children = RAM for PHP / ~80 MB per worker.
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500

# ---------------------------------------------------------------------------
# Mail (SMTP). Without SMTP_HOST, WordPress can't send mail (order emails!).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS), ssl (implicit TLS), none, or empty (STARTTLS if offered).
#SMTP_SECURE=
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Cron, backups, Redis
# ---------------------------------------------------------------------------
#CRON_INTERVAL=60
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7
# Redis object cache: add "redis" to COMPOSE_PROFILES and set REDIS_HOST=redis.
#REDIS_HOST=
#REDIS_MAXMEMORY=128mb

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#DB_MEMORY_LIMIT=1g
#WP_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#CRON_MEMORY_LIMIT=512m
#REDIS_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
