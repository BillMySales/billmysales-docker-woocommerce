# Caddy in front of the WordPress PHP-FPM container.
# Docs: https://caddyserver.com/docs/caddyfile/directives/php_fastcgi
{
	# No admin API: config is static, reloads happen by restarting the container.
	admin off

	servers {
		# Behind a reverse proxy on a private network, log the real client IP
		# (X-Forwarded-For). HTTPS detection is done by the image's wp-config.php,
		# which turns X-Forwarded-Proto: https into HTTPS=on.
		trusted_proxies static private_ranges
		# Client IP = the right-most untrusted address (can't be spoofed).
		trusted_proxies_strict
	}
}

(wordpress) {
	root * /var/www/html
	encode zstd gzip

	# Same variable as upload_max_filesize/post_max_size in config/php/php.ini.
	request_body {
		max_size {$UPLOAD_MAX_SIZE}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Hide dotfiles (.htaccess, .git, ...), except .well-known.
	@hidden {
		path /.*
		not path /.well-known/*
	}
	respond @hidden 403

	# No PHP execution from the uploads directory.
	@uploads_php path_regexp ^/wp-content/uploads/.*\.php$
	respond @uploads_php 403

	@static path *.css *.js *.mjs *.gif *.ico *.jpg *.jpeg *.png *.svg *.webp *.avif *.woff *.woff2 *.ttf *.eot
	header @static Cache-Control "public, max-age=604800"

	# Sends *.php and unknown paths (pretty permalinks, /wp-json/...) to
	# index.php through FastCGI; everything else is served as a static file.
	# PHP's REMOTE_ADDR is the client, not the proxy in front (e.g. Traefik).
	php_fastcgi wordpress:9000 {
		env REMOTE_ADDR {client_ip}
	}
	file_server
}

# Public site. SITE_ADDRESS is ":80" for plain HTTP (local, or behind another
# proxy) or a domain name, which makes Caddy obtain and renew a certificate
# automatically ("localhost" uses Caddy's internal CA).
{$SITE_ADDRESS} {
	import wordpress
	log {
		output stdout
	}
}

# Internal-only site (port not published) for the container healthcheck, so it
# works whatever SITE_ADDRESS is.
:8080 {
	import wordpress
}
